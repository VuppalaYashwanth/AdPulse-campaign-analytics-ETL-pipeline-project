# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adpulse
POSTGRES_USER=adpulse
POSTGRES_PASSWORD=adpulse

# --- Optional S3 raw-data landing zone ---
USE_S3=false
S3_BUCKET=
AWS_REGION=us-east-1

# --- Data quality thresholds ---
MAX_ALLOWED_NULL_FRACTION=0.02
ROW_COUNT_DRIFT_TOLERANCE=0.0
